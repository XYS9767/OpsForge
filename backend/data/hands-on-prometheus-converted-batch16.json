      "test_files": {
        "checks/check.py": "import pathlib,json,copy,yaml,subprocess,tempfile,shutil\nclass Strict(yaml.SafeLoader):pass\ndef mapping(loader,node,deep=False):\n loader.flatten_mapping(node);d={}\n for k,v in node.value:\n  key=loader.construct_object(k,deep=deep)\n  if key in d:raise ValueError('duplicate key')\n  d[key]=loader.construct_object(v,deep=deep)\n return d\nStrict.add_constructor(yaml.resolver.BaseResolver.DEFAULT_MAPPING_TAG,mapping)\ndef load(name):return yaml.load(pathlib.Path(name).read_text(encoding='utf-8'),Loader=Strict)\n\nEXPECTED={'groups': [{'name': 'multiwindow-budget-routing', 'interval': '1m', 'rules': [{'record': 'service:error_burn:5m', 'expr': '((sum by(service)(rate(errors_total[5m])) / sum by(service)(rate(requests_total[5m]))) / 0.001) and on(service) (sum by(service)(rate(requests_total[5m])) > 0)'}, {'record': 'service:requests_increase:5m', 'expr': 'sum by(service)(increase(requests_total[5m]))'}, {'record': 'service:error_burn:30m', 'expr': '((sum by(service)(rate(errors_total[30m])) / sum by(service)(rate(requests_total[30m]))) / 0.001) and on(service) (sum by(service)(rate(requests_total[30m])) > 0)'}, {'record': 'service:requests_increase:30m', 'expr': 'sum by(service)(increase(requests_total[30m]))'}, {'record': 'service:error_burn:2h', 'expr': '((sum by(service)(rate(errors_total[2h])) / sum by(service)(rate(requests_total[2h]))) / 0.001) and on(service) (sum by(service)(rate(requests_total[2h])) > 0)'}, {'record': 'service:requests_increase:2h', 'expr': 'sum by(service)(increase(requests_total[2h]))'}, {'alert': 'ErrorBudgetPage', 'expr': '(service:error_burn:5m > 14.4) and on(service) (service:error_burn:30m > 14.4) and on(service) (service:requests_increase:5m >= 100) and on(service) (service:requests_increase:30m >= 1000)', 'for': '2m', 'labels': {'severity': 'page'}, 'annotations': {'summary': 'Fast sustained error-budget burn'}}, {'alert': 'ErrorBudgetTicket', 'expr': '((service:error_burn:30m > 6) and on(service) (serv