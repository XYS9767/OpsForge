 82 84 86 88 90 92 94 96 98 100\n      102 104 106 108 110 112 114 116 118 120 122 124 126 128 130 132 134 136 138\n      140 142 144 146 148 150 152 154 156 158 160 162 164 166 168 170 172 174 176\n      178 180 182 184 186 188 190 192 194 196 198 200 202 204 206 208 210 212 214\n      216 218 220 222 224 226 228 230 232 234 236 238 240 242 244 246 248 250 252\n      254 256 258 260 262 264 266 268 270 272\n  promql_expr_test:\n  - expr: round(service:error_burn:5m{service=~\"page|ticket|healthy\"}, 0.000001)\n    eval_time: 125m\n    exp_samples:\n    - labels: '{service=\"page\"}'\n      value: 20\n    - labels: '{service=\"ticket\"}'\n      value: 8\n    - labels: '{service=\"healthy\"}'\n      value: 0.1\n  - expr: round(service:error_burn:30m{service=~\"page|ticket|healthy\"}, 0.000001)\n    eval_time: 125m\n    exp_samples:\n    - labels: '{service=\"page\"}'\n      value: 20\n    - labels: '{service=\"ticket\"}'\n      value: 8\n    - labels: '{service=\"healthy\"}'\n      value: 0.1\n  - expr: round(service:error_burn:2h{service=~\"page|ticket|healthy\"}, 0.000001)\n    eval_time: 125m\n    exp_samples:\n    - labels: '{service=\"page\"}'\n      value: 20\n    - labels: '{service=\"ticket\"}'\n      value: 8\n    - labels: '{service=\"healthy\"}'\n      value: 0.1\n  alert_rule_test:\n  - eval_time: 120m\n    alertname: ErrorBudgetPage\n    exp_alerts:\n    - exp_labels:\n        service: page\n        severity: page\n      exp_annotations:\n        summary: Fast sustained error-budget burn\n  - eval_time: 120m\n    alertname: ErrorBudgetTicket\n    exp_alerts:\n    - exp_labels:\n        service: ticket\n        severity: ticket\n      exp_annotations:\n        summary: Slow sustained error-budget burn\n  - eval_time: 125m\n    alertname: ErrorBudgetPage\n    exp_alerts:\n    - exp_labels:\n        service: page\n        severity: page\n      exp_annotations:\n        summary: Fast sustained error-budget burn\n  - eval_time: 125m\n    alertname: ErrorBudge