#!/bin/sh
set -eu

if [ "${OPSF_PRIVATE_CGROUP_NAMESPACE_READY:-false}" != true ]; then
    export OPSF_PRIVATE_CGROUP_NAMESPACE_READY=true
    exec /usr/local/bin/opsforge-cgroup-namespace "$0" "$@"
fi

# Only this new private sidecar's local image directory is populated.
image_dir=/var/lib/rancher/k3s/agent/images
mkdir -p "$image_dir"
found=false
for archive in /opt/opsforge/node-images/*.tar; do
    [ -f "$archive" ] || continue
    cp "$archive" "$image_dir/$(basename "$archive")"
    found=true
done
if [ "$found" != true ]; then
    echo 'OpsForge private-node image archives are missing' >&2
    exit 1
fi
exec /bin/k3s "$@"
