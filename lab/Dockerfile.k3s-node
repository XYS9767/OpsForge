# Build with the lab directory as context; archives are supplied by release tooling.
ARG CGROUP_BUILDER_IMAGE=opsforge-lab:20261025-native-next
FROM ${CGROUP_BUILDER_IMAGE} AS cgroup-launcher
USER root
COPY opsforge-cgroup-namespace.c /tmp/opsforge-cgroup-namespace.c
RUN gcc -static -O2 -Wall -Wextra -Werror /tmp/opsforge-cgroup-namespace.c -o /tmp/opsforge-cgroup-namespace

FROM rancher/k3s@sha256:5e0707cfd1239b358ef73f3254bc3eadc027dd30cd5ec6ca41e29e47652a1b8c
COPY --from=cgroup-launcher --chmod=0755 /tmp/opsforge-cgroup-namespace /usr/local/bin/opsforge-cgroup-namespace
COPY node-images/*.tar /opt/opsforge/node-images/
COPY --chmod=0755 opsforge-k3s-bootstrap /usr/local/bin/opsforge-k3s-bootstrap
