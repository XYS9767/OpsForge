# Add the real upstream Kubernetes controller process to the validated lab.
FROM opsforge-lab:20261025-pilot
USER root
RUN curl --fail --location --retry 3 --connect-timeout 15 --max-time 180 \
      https://dl.k8s.io/release/v1.34.1/bin/linux/amd64/kube-controller-manager \
      -o /usr/local/bin/kube-controller-manager \
    && echo '91b7aa8c599f93515f347d3ee7fb12229a40db0ca02da3e7c5dc96fbca3ad2f3  /usr/local/bin/kube-controller-manager' | sha256sum -c - \
    && chmod 0755 /usr/local/bin/kube-controller-manager \
    && /usr/local/bin/kube-controller-manager --version
USER 1000:1000
