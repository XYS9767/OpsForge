#!/usr/bin/env bash
set -eu
mkdir -p /workspace/.cache /workspace/.kube
printf 'TOKEN=training-only\n' > /workspace/config.env
chmod 666 /workspace/config.env
python3 - <<'PY'
import json, os
from pathlib import Path
token=Path('/var/run/secrets/kubernetes.io/serviceaccount/token')
if token.exists():
    host=os.environ.get('KUBERNETES_SERVICE_HOST','kubernetes.default.svc')
    if ':' in host and not host.startswith('['): host='['+host+']'
    cfg={'apiVersion':'v1','kind':'Config','clusters':[{'name':'practice','cluster':{'server':'https://'+host+':'+os.environ.get('KUBERNETES_SERVICE_PORT','443'),'certificate-authority':str(token.with_name('ca.crt'))}}],
         'users':[{'name':'student','user':{'tokenFile':str(token)}}],
         'contexts':[{'name':'practice','context':{'cluster':'practice','user':'student','namespace':os.environ['PRACTICE_NAMESPACE']}}],'current-context':'practice'}
    Path('/workspace/.kube/config').write_text(json.dumps(cfg))
PY
exec sleep 3500
