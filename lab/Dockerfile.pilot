# Difficult-direction pilot: native services, no remote daemon or host socket.
FROM apache/kafka@sha256:3f7b939115cd4872e9cee9369d80bd69712fde55f9902f46d793f64848dedc75 AS kafka
FROM pingcap/tidb@sha256:e986dadd59937fbfcbdfe7fd084421cc65988da8b795f75194b05a0292635ead AS tidb
FROM pingcap/pd@sha256:672f499607a9f378f01ed0f78b2aa073d689b67ca1a820d58176660191db769b AS pd
FROM pingcap/tikv@sha256:12f547570dd2bfe56f20fd349c6b80335520a2ff7b0fd82c98071a507a9d202c AS tikv
FROM opsforge-lab:20261025-local
ARG TARGETARCH=amd64
USER root
RUN test "$TARGETARCH" = amd64 \
    && apt-get update \
    && apt-get install -y --no-install-recommends openjdk-17-jre-headless \
    && rm -rf /var/lib/apt/lists/*
COPY --from=kafka /opt/kafka /opt/kafka
COPY --from=tidb /tidb-server /usr/local/bin/tidb-server
COPY --from=pd /pd-server /usr/local/bin/pd-server
COPY --from=tikv /tikv-server /usr/local/bin/tikv-server
COPY pilot-requirements.txt /opt/opsforge/pilot-requirements.txt
RUN python3 -m pip install --break-system-packages --no-cache-dir --only-binary=:all: \
      --require-hashes -r /opt/opsforge/pilot-requirements.txt \
    && java -version \
    && test -f /opt/kafka/libs/kafka_2.13-4.0.0.jar \
    && tidb-server -V && pd-server -V && tikv-server -V \
    && python3 -c 'import confluent_kafka; assert confluent_kafka.__version__ == "2.10.1"'
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64 KAFKA_HOME=/opt/kafka
USER 1000:1000
