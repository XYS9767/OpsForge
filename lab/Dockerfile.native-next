# Compiler for real Kafka Streams tests, preserving the previous lab tags.
FROM opsforge-lab:20261025-controllers
USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends openjdk-17-jdk-headless=17.0.21+9-1~deb12u1 \
    && rm -rf /var/lib/apt/lists/* \
    && javac -version && java -version
USER 1000:1000
